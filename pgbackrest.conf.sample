# pgBackRest configuration file

[global]

# Repository settings
repo1-type=s3
repo1-path=<s3_repo_path>
repo1-s3-endpoint=<s3_server_url>
repo1-s3-bucket=<s3_bucket_name>
repo1-s3-uri-style=path
repo1-s3-verify-tls=<n|s>
repo1-s3-key=<s3_key>
repo1-s3-key-secret=<s3_secret_key>
repo1-s3-region=<s3_region>

# Backup encryption settings
repo1-cipher-pass=<encryption_password>
repo1-cipher-type=aes-256-cbc

repo1-retention-full=14
repo1-retention-full-type=time
repo1-host-user=postgres
archive-check=n

log-level-console=info
log-path=/var/log/pgbackrest
log-level-file=debug

spool-path=/var/spool/pgbackrest

process-max=2
start-fast=y
delta=y

[stanza_name]
repo1-s3-bucket=<s3_stanza_repo_path>
pg1-path=/var/lib/postgresql
