##############################################################################
# pgBackRest settings

# pgBackRest version (default latest)
PGBACKREST_VERSION=latest

# pgBackRest default stanza
PGBACKREST_STANZA=pgbackrest


##############################################################################
# PostgreSQL settings

# PostgreSQL major version
POSTGRES_VERSION=17

# PostgreSQL user (will be created when container start)
POSTGRES_USER=postgres

# PostgreSQL user's password (will be set when container start)
POSTGRES_PASSWORD=postgres

# Host port exposed by the PostgreSQL container (default if free, otherwise
# the first free port in POSTGRESQL_HOST_PORT_RANGE is chosen automatically)
POSTGRESQL_HOST_PORT=5432

# Range of fallback ports tried in order when POSTGRESQL_HOST_PORT is busy
# Format: START-END (e.g. 5433-5450)
POSTGRESQL_HOST_PORT_RANGE=5433-5450

# PostgreSQL data directory (should match the data directory of the backup
# source host
PGDATA=/var/lib/postgresql/data/
